# =============================================================================
# DJANGO CPANEL DEPLOYMENT CONFIGURATION EXAMPLE
# =============================================================================

DEBUG=True
SECRET_KEY=generate-a-secure-random-secret-key-for-production
ALLOWED_HOSTS=*,127.0.0.1,localhost,.jpec.com.np

# SQLite (Default)
DB_ENGINE=django.db.backends.sqlite3

# MySQL / MariaDB (Optional on cPanel)
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=cpaneluser_jpecdb
# DB_USER=cpaneluser_jpecuser
# DB_PASSWORD=your_secure_db_password
# DB_HOST=localhost
# DB_PORT=3306

# CORS & CSRF Origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000,http://127.0.0.1:3000,https://jpec.com.np,https://www.jpec.com.np
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://localhost:3000,http://127.0.0.1:3000,http://127.0.0.1:8000,https://jpec.com.np,https://www.jpec.com.np,https://*.jpec.com.np
